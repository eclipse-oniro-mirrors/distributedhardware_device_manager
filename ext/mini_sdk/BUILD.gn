import("//build/ohos.gni")
import("//foundation/distributedhardware/device_manager/device_manager.gni")

# Each mini sdk adapter only depends on ipc and samgr: it talks to the target
# system ability directly over IPC (same protocol as the official sdk proxy)
# instead of linking the full third party sdk client library, so no sdk part
# (bluetooth / wifi / power_manager / screenlock_mgr) is pulled into the
# device_manager process through these adapters.
ohos_shared_library("libbt_mini_sdk") {
  if (!device_manager_capability) {
    install_enable = false
  } else {
    branch_protector_ret = "pac_ret"

    sanitize = {
      boundary_sanitize = true
      cfi = true
      cfi_cross_dso = true
      debug = false
      integer_overflow = true
      ubsan = true
    }

    cflags = [
      "-fPIC",
      "-fstack-protector-strong",
      "-Wall",
      "-Werror",
    ]

    ldflags = [
      "-Wl,-z,relro",
      "-Wl,-z,now",
    ]

    include_dirs = [
      "include",
      "${common_path}/include",
    ]

    sources = [ "src/bt_mini_sdk.cpp" ]

    defines = [
      "HI_LOG_ENABLE",
      "DH_LOG_TAG=\"dmminisdk\"",
      "LOG_DOMAIN=0xD004110",
    ]

    if (support_bluetooth) {
      defines += [ "SUPPORT_BLUETOOTH" ]
    }

    external_deps = [
      "hilog:libhilog",
      "ipc:ipc_single",
      "samgr:samgr_proxy",
    ]

    subsystem_name = "distributedhardware"
    part_name = "device_manager"
  }
}

